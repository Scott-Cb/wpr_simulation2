Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Displays:
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: CameraImage
      Topic:
        Value: /kinect2/qhd/image_raw
      Transport Hint: raw
    - Alpha: 1
      Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: PointCloud2
      Topic:
        Value: /kinect2/sd/points
  Enabled: true
  Global Options:
    Fixed Frame: base_footprint
  Name: root
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 2.5
Window Geometry:
  Width: 1280
  Height: 720
